{
  "manifest_version": 3,
  "name": "UX Audit Buddy",
  "version": "0.1.0",
  "description": "Audit any web page for UX issues, strengths and USP, and download a report.",
  "action": {
    "default_title": "Audit this page",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": ["activeTab", "scripting"]
}
