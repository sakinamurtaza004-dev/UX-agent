# Copy this file to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=

# Optional settings (defaults shown)
# MODEL=claude-opus-5-5
# EFFORT=medium            # low | medium | high : higher thinks longer and costs more
# PORT=8787
# HOST=127.0.0.1           # keep as localhost unless you deploy, then set APP_TOKEN too
# APP_TOKEN=               # shared secret the extension must send (needed if HOST is not localhost)
# RATE_LIMIT_PER_HOUR=10   # per client
# MAX_REVIEWS_PER_DAY=100  # hard cap for the whole server (protects your bill)
# DISABLE_FALLBACKS=1      # turn off the automatic fallback if the AI declines a request
